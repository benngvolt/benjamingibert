# Activer le moteur de réécriture
RewriteEngine On
RewriteBase /

# www -> non-www (évite le contenu en double vu par Google sur les deux domaines)
RewriteCond %{HTTP_HOST} ^www\.benjamingibert\.com$ [NC]
RewriteRule ^ https://benjamingibert.com%{REQUEST_URI} [L,R=301]

# Cache long pour assets versionnés / médias
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|png|jpg|jpeg|webp|avif|gif|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Ne pas mettre index.html en cache long
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression si dispo
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Empêcher les boucles infinies
RewriteRule ^index\.html$ - [L]

# Si le fichier ou dossier existe, on le sert normalement
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pages prérendues au build (scripts/prerender.js) : /about est servi par about.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Sinon, fallback React Router
RewriteRule ^ index.html [L]
